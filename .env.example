# ------------------------------------------------------------------
# MuyBieno Link — ortam değişkenleri
# ------------------------------------------------------------------

# Postgres (sunucuda platform-postgres, platform-db network üzerinden)
# Prod deseni: postgresql://<user>:<pass>@platform-postgres:5432/<db>
DATABASE_URL="postgresql://muybieno_link:CHANGE_ME@platform-postgres:5432/muybieno_link"

# Admin oturum imzalama anahtarı (min 32 karakter rastgele)
AUTH_SECRET="CHANGE_ME_generate_a_long_random_string"

# İlk admin kullanıcısı (seed sırasında oluşturulur)
ADMIN_EMAIL="umit.rk@gmail.com"
ADMIN_PASSWORD="CHANGE_ME"

# IP adreslerini hashlemek için tuz (analytics gizliliği)
IP_HASH_SALT="CHANGE_ME_random_salt"

# Shopify (ürün otomatik çekme) — muybieno.com mağazası
# Storefront API (public token) tercih edilir
SHOPIFY_STORE_DOMAIN="muybieno.com"
SHOPIFY_STOREFRONT_TOKEN=""
# Alternatif: Admin API (özel uygulama)
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_API_VERSION="2025-01"

# Public site adresi
NEXT_PUBLIC_SITE_URL="https://link.muybieno.com"
